{
  "name": "board-table",
  "private": true,
  "description": "Private, invite-only site for playing board games online with friends.",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:web": "npm run start -w @board-table/web",
    "build:web": "npm run build -w @board-table/web",
    "test:web": "npm test -w @board-table/web",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}

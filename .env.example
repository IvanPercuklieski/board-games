# Template for .env.dev (board-games-dev) and .env.prod (board-games).
# Copy to .env.dev / .env.prod and fill in. Both are gitignored; never commit them.

# Server
PORT=3000
PUBLIC_ORIGIN=http://localhost:4200

# Supabase: public values (safe to send to the browser)
# Dashboard -> Project Settings -> API (Project URL, anon/publishable key)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Supabase: SERVER ONLY, never expose to the browser or logs
# Dashboard -> Project Settings -> API (service_role/secret key)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Dashboard -> Connect -> Session pooler connection string (put your DB password in it)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres

# Optional: folder with the built web app, served by the Node server (production / local prod test).
# From the repo root: apps/web/dist/web/browser
# WEB_DIST_DIR=apps/web/dist/web/browser
